---
import '../styles/global.css';
import MobileNav from '../components/MobileNav.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Product Ops & AI Automation Engineer building AI-powered workflows. Currently scaling HelloBible from 15k to 140k downloads.",
  image = "/assets/og-image.png"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0A1410" />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght,ital@9..144,400;9..144,500;9..144,600;9..144,400,1;9..144,500,1&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght,ital@9..144,400;9..144,500;9..144,600;9..144,400,1;9..144,500,1&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght,ital@9..144,400;9..144,500;9..144,600;9..144,400,1;9..144,500,1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </noscript>

  <ViewTransitions />
  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div class="atmosphere" aria-hidden="true"></div>
  <canvas id="forest-canvas" aria-hidden="true"></canvas>
  <canvas id="webgl-canvas" aria-hidden="true"></canvas>

  <!-- Filaments SVG - visible on all pages -->
  <svg class="filaments-global" aria-hidden="true" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <path class="fg f1" d="M-40,300 Q200,150 500,250 T900,200 T1300,120 T1500,60"/>
    <path class="fg f2" d="M-40,500 Q250,380 520,440 T880,320 T1200,370 T1500,280"/>
    <path class="fg f3" d="M700,950 Q680,700 760,480 T820,200 T860,-20"/>
    <path class="fg f4" d="M200,950 Q240,720 190,530 T310,290 T360,40"/>
    <path class="fg f5" d="M1100,950 Q1080,700 1160,500 T1200,220 T1220,-20"/>
    <circle class="fn" cx="500" cy="250" r="2.5"/>
    <circle class="fn" cx="520" cy="440" r="2"/>
    <circle class="fn" cx="760" cy="480" r="2.5"/>
    <circle class="fn" cx="240" cy="530" r="2"/>
    <circle class="fn" cx="820" cy="200" r="3"/>
    <circle class="fn" cx="1160" cy="500" r="2"/>
    <circle class="fn" cx="900" cy="200" r="2"/>
  </svg>

  <slot name="nav">
    <slot name="default-nav" />
  </slot>

  <main id="main-content" transition:animate="fade">
    <slot />
  </main>

  <slot name="footer" />
  <MobileNav />

  <script is:inline src="/scripts/scroll-reveal.js"></script>
  <script is:inline src="/scripts/copy-email.js"></script>
  <script is:inline src="/scripts/video-player.js"></script>
  <script is:inline src="/scripts/mobile-nav.js"></script>

  <script is:inline src="/scripts/forest-tier.js"></script>
  <script is:inline src="/scripts/forest-canvas.js"></script>
  <script is:inline src="/scripts/forest-webgl.js"></script>
  <script is:inline src="/scripts/forest-filaments.js"></script>
</body>
</html>
