---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const data = project.data;
---

<BaseLayout title={`${data.title} · Arnaud Duflot`} description={data.pitch}>
  <Nav slot="nav" />

  <article class="project">
    <div class="container container--narrow">
      <!-- Header -->
      <header class="project__header reveal">
        <a href="/#work" class="project__back">← Back to work</a>
        <span class="tag">{data.tag}</span>
        <h1 class="project__title">{data.title}</h1>
        <p class="project__pitch">{data.pitch}</p>
      </header>

      <!-- Hero media -->
      {data.heroVideo ? (
        <div class="project__hero reveal">
          <video src={data.heroVideo} autoplay muted loop playsinline></video>
        </div>
      ) : data.hero ? (
        <div class="project__hero reveal">
          <img src={data.hero} alt={data.title} />
        </div>
      ) : null}

      <!-- Metrics -->
      {data.metrics && data.metrics.length > 0 && (
        <div class="project__metrics reveal">
          {data.metrics.map((metric) => (
            <div class="metric">
              <span class="metric__label">{metric.label}</span>
              <span class="metric__value">{metric.value}</span>
              {metric.sublabel && <span class="metric__sublabel">{metric.sublabel}</span>}
            </div>
          ))}
        </div>
      )}

      <!-- Stack -->
      <div class="project__stack reveal">
        {data.stack.map((tech) => <span class="pill">{tech}</span>)}
      </div>

      <!-- Content -->
      <div class="project__content reveal">
        <Content />
      </div>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .project {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .project__back {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 2rem;
    transition: color 0.2s var(--ease-out);
  }

  .project__back:hover {
    color: var(--accent-bright);
  }

  .project__header {
    margin-bottom: 3rem;
  }

  .project__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 1rem 0 1.25rem;
  }

  .project__pitch {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 720px;
  }

  .project__hero {
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid var(--border);
    background: var(--bg-deep);
  }

  .project__hero img,
  .project__hero video {
    width: 100%;
    height: auto;
    display: block;
  }

  .project__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .metric__label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }

  .metric__value {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    color: var(--accent-bright);
    letter-spacing: -0.02em;
  }

  .metric__sublabel {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(242, 239, 232, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  /* Content (MDX) */
  .project__content {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .project__content :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 3rem 0 1.25rem;
    line-height: 1.2;
  }

  .project__content :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
    margin: 2rem 0 0.75rem;
  }

  .project__content :global(p) {
    margin-bottom: 1.25rem;
  }

  .project__content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .project__content :global(em) {
    color: var(--accent-bright);
    font-style: italic;
  }

  .project__content :global(a) {
    color: var(--accent-bright);
    text-decoration: underline;
    text-decoration-color: rgba(115, 179, 146, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }

  .project__content :global(a:hover) {
    text-decoration-color: var(--accent-bright);
  }

  .project__content :global(ul),
  .project__content :global(ol) {
    margin: 1.25rem 0 1.5rem 1.5rem;
    padding-left: 0.5rem;
  }

  .project__content :global(li) {
    margin-bottom: 0.5rem;
    list-style: disc;
    color: var(--text-muted);
  }

  .project__content :global(blockquote) {
    border-left: 3px solid var(--accent-bright);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .project__content :global(code) {
    background: var(--surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--accent-bright);
  }

  .project__content :global(pre) {
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .project__content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-muted);
  }

  .project__content :global(img),
  .project__content :global(video) {
    width: 100%;
    border-radius: var(--radius-md);
    margin: 2rem 0;
    border: 1px solid var(--border);
  }
</style>
