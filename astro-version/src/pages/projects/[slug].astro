---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const data = project.data;
---

<BaseLayout title={`${data.title} · Arnaud Duflot`} description={data.pitch}>
  <Nav slot="nav" />

  <!-- Filament SVG overlay - animates on page enter -->
  <svg class="filaments" aria-hidden="true" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
    <g class="filaments__group">
      <path class="filament f1" d="M-20,400 Q150,200 400,300 T800,250 T1100,180 T1300,100"/>
      <path class="filament f2" d="M-20,550 Q200,400 450,480 T750,350 T1050,400 T1300,320"/>
      <path class="filament f3" d="M600,820 Q580,600 650,400 T700,150 T750,0"/>
      <path class="filament f4" d="M200,820 Q250,650 200,500 T300,300 T350,100"/>
      <path class="filament f5" d="M900,820 Q880,620 950,450 T980,200 T1000,0"/>
      <!-- Nodes at intersections -->
      <circle class="node" cx="400" cy="300" r="3"/>
      <circle class="node" cx="450" cy="480" r="2"/>
      <circle class="node" cx="650" cy="400" r="2.5"/>
      <circle class="node" cx="250" cy="500" r="2"/>
      <circle class="node" cx="700" cy="250" r="3"/>
      <circle class="node" cx="950" cy="450" r="2"/>
    </g>
  </svg>

  <article class="project">
    <div class="container container--narrow">
      <!-- Header -->
      <header class="project__header reveal">
        <a href="/#work" class="project__back">← Back to work</a>
        <div class="project__meta">
          <span class="tag">{data.tag}</span>
        </div>
        <h1 class="project__title">{data.title}</h1>
        <p class="project__pitch">{data.pitch}</p>
        <div class="project__summary">
          <p><strong>Context.</strong> {data.context}</p>
          <p><strong>Result.</strong> {data.result}</p>
        </div>
      </header>

      <!-- Hero media -->
      {data.heroVideo ? (
        <div class="project__hero reveal">
          <video src={data.heroVideo} autoplay muted loop playsinline preload="metadata"></video>
        </div>
      ) : data.hero ? (
        <div class="project__hero reveal">
          <img src={data.hero} alt={`Hero visual for ${data.title}`} loading="eager" decoding="async" />
        </div>
      ) : null}

      <!-- Metrics -->
      {data.metrics && data.metrics.length > 0 && (
        <div class="project__metrics reveal">
          {data.metrics.map((metric) => (
            <div class="metric">
              <span class="metric__label">{metric.label}</span>
              <span class="metric__value">{metric.value}</span>
              {metric.sublabel && <span class="metric__sublabel">{metric.sublabel}</span>}
            </div>
          ))}
        </div>
      )}

      <!-- Stack -->
      <div class="project__stack reveal">
        {data.stack.map((tech) => <span class="pill">{tech}</span>)}
      </div>

      <!-- Content -->
      <div class="project__content">
        <Content />
      </div>

      <!-- Contact / CTA -->
      <div class="project__contact reveal">
        <h3 class="project__contact-title">Want to talk about something like this?</h3>
        <p class="project__contact-lede">
          Email me, send a LinkedIn message, or download the CV. Conversations are what this site is built for.
        </p>
        <div class="project__contact-actions">
          <button class="btn btn--primary" id="copyEmailBtnProject" type="button" aria-label="Copy email">
            duflot.arnaud@gmail.com
          </button>
          <a href="https://www.linkedin.com/in/arnaud-duflot-383192119/" class="btn btn--ghost" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="/assets/cv-arnaud-duflot.pdf" class="btn btn--ghost" download>Download CV</a>
        </div>
        <div class="project__contact-toast" id="copyToastProject" role="status" aria-live="polite">Email copied to clipboard</div>
      </div>
    </div>
  </article>

  <Footer slot="footer" />

  <script>
    // Count-up animation on metric values
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function animateCountUp(el) {
      const original = el.textContent?.trim() || '';
      const match = original.match(/^([^\d-]*)(-?[\d,]+(?:\.\d+)?)(.*)$/);
      if (!match) return;
      const [, prefix, numStr, suffix] = match;
      if (/\d/.test(suffix)) return; // multiple numbers, skip
      const target = parseFloat(numStr.replace(/,/g, ''));
      if (isNaN(target) || target === 0) return;

      const duration = 1400;
      const start = performance.now();
      const hasComma = numStr.includes(',');
      const decimals = (numStr.split('.')[1] || '').length;

      function format(n: number) {
        let intPart = decimals > 0 ? n.toFixed(decimals) : Math.floor(n).toString();
        if (hasComma) {
          const parts = intPart.split('.');
          parts[0] = parseInt(parts[0]).toLocaleString('en-US');
          intPart = parts.join('.');
        }
        return intPart;
      }

      function update(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = eased * target;
        el.textContent = prefix + format(current) + suffix;
        if (progress < 1) requestAnimationFrame(update);
      }

      el.textContent = prefix + format(0) + suffix;
      requestAnimationFrame(update);
    }

    if (!reduceMotion && 'IntersectionObserver' in window) {
      const metricObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCountUp(entry.target as HTMLElement);
            metricObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      document.querySelectorAll('.metric__value').forEach((el) => metricObserver.observe(el));
    }
  </script>
</BaseLayout>

<style>
  .project {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .project__back {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 2rem;
    transition: color 0.2s var(--ease-out);
  }

  .project__contact {
    margin-top: 5rem;
    padding: 3rem 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .project__contact-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .project__contact-lede {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .project__contact-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project__contact-toast {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--accent-bright);
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }

  .project__contact-toast.visible {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .project__contact {
      padding: 2rem 1.5rem;
    }
    .project__contact-actions {
      flex-direction: column;
    }
    .project__contact-actions .btn {
      width: 100%;
    }
  }

  .project__back:hover {
    color: var(--accent);
  }

  .project__header {
    margin-bottom: 3rem;
  }

  .project__meta {
    margin-top: 2.5rem;
    margin-bottom: 2rem;
  }

  .project__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 1rem 0 1.25rem;
  }

  .project__pitch {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 720px;
  }

  .project__summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .project__summary strong {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 0.35rem;
  }

  .project__hero {
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 3rem;
    border: 1px solid var(--border);
    background: var(--bg-deep);
  }

  .project__hero img,
  .project__hero video {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: top center;
  }

  .project__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .metric__label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }

  .metric__value {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    color: var(--accent-bright);
    letter-spacing: -0.02em;
  }

  .metric__sublabel {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(242, 239, 232, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  /* Content (MDX) */
  .project__content {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .project__content :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 3rem 0 1.25rem;
    line-height: 1.2;
  }

  .project__content :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
    margin: 2rem 0 0.75rem;
  }

  .project__content :global(p) {
    margin-bottom: 1.25rem;
  }

  .project__content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .project__content :global(em) {
    color: var(--accent-muted);
    font-style: italic;
  }

  .project__content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(130, 227, 182, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }

  .project__content :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .project__content :global(ul),
  .project__content :global(ol) {
    margin: 1.25rem 0 1.5rem 1.5rem;
    padding-left: 0.5rem;
  }

  .project__content :global(li) {
    margin-bottom: 0.5rem;
    list-style: disc;
    color: var(--text-muted);
  }

  .project__content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .project__content :global(code) {
    background: var(--surface);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--accent-muted);
  }

  .project__content :global(pre) {
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .project__content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-muted);
  }

  .project__content :global(img),
  .project__content :global(video) {
    width: 100%;
    border-radius: var(--radius-md);
    margin: 2rem 0;
    border: 1px solid var(--border);
  }

  /* Filaments */
  .filaments {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  .filament {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: drawFilament 2.4s var(--ease-out) forwards;
  }

  .f1 {
    stroke: rgba(130, 227, 182, 0.18);
    stroke-width: 1.5;
    animation-delay: 0.1s;
  }
  .f2 {
    stroke: rgba(63, 168, 118, 0.12);
    stroke-width: 1;
    animation-delay: 0.35s;
  }
  .f3 {
    stroke: rgba(212, 175, 55, 0.1);
    stroke-width: 1;
    animation-delay: 0.55s;
  }
  .f4 {
    stroke: rgba(130, 227, 182, 0.1);
    stroke-width: 0.8;
    animation-delay: 0.75s;
  }
  .f5 {
    stroke: rgba(31, 107, 74, 0.15);
    stroke-width: 1.2;
    animation-delay: 0.2s;
  }

  .node {
    fill: rgba(130, 227, 182, 0.5);
    opacity: 0;
    animation: fadeNode 0.6s var(--ease-out) forwards;
    filter: drop-shadow(0 0 4px rgba(130, 227, 182, 0.8));
  }

  .node:nth-child(1) { animation-delay: 1s; }
  .node:nth-child(2) { animation-delay: 1.2s; }
  .node:nth-child(3) { animation-delay: 1.4s; }
  .node:nth-child(4) { animation-delay: 1.1s; }
  .node:nth-child(5) { animation-delay: 1.3s; }
  .node:nth-child(6) { animation-delay: 1.5s; }

  @keyframes drawFilament {
    0% {
      stroke-dashoffset: 1200;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes fadeNode {
    from { opacity: 0; transform: scale(0); }
    to   { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .filaments { display: none; }
  }
</style>
