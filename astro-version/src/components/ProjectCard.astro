---
interface Props {
  slug: string;
  title: string;
  tag: string;
  pitch: string;
  hero?: string;
  heroVideo?: string;
  stack: string[];
  featured?: boolean;
}

const { slug, title, tag, pitch, hero, heroVideo, stack, featured } = Astro.props;
---

<a href={`/projects/${slug}`} class="card reveal">
  {heroVideo ? (
    <video
      src={heroVideo}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      class="card__media"
    />
  ) : hero ? (
    <img src={hero} alt={`Preview of ${title}`} loading="lazy" decoding="async" class="card__media" />
  ) : (
    <div class="card__media card__media--empty"></div>
  )}

  <div class="card__body">
    <div class="card__meta">
      <span class="card__tag">{tag}</span>
      {featured && <span class="card__featured">Featured</span>}
    </div>
    <h3 class="card__title">{title}</h3>
    <p class="card__pitch">{pitch}</p>
    <div class="card__stack">
      {stack.slice(0, 4).map((tech) => <span class="pill">{tech}</span>)}
    </div>
    <span class="card__arrow" aria-hidden="true">
      Read case study →
    </span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.4s var(--ease-out);
    position: relative;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(130, 227, 182, 0.08), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-border);
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    object-position: center;
    background: var(--bg-deep);
    border-bottom: 1px solid var(--border);
    padding: 1.25rem;
    box-sizing: border-box;
  }

  .card__media--empty {
    background: linear-gradient(135deg, var(--surface) 0%, var(--bg-deep) 100%);
  }

  .card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-muted);
  }

  .card__featured {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-bright);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-full);
  }

  .card__title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .card__pitch {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    flex: 1;
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .pill {
    padding: 0.25rem 0.65rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(242, 239, 232, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  .card__arrow {
    margin-top: 0.75rem;
    color: var(--accent-bright);
    font-size: 0.875rem;
    font-weight: 500;
    transition: gap 0.2s var(--ease-out);
  }

  .card:hover .card__arrow {
    letter-spacing: 0.02em;
  }
</style>
